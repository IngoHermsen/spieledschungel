---
import BaseLayout from "./BaseLayout.astro";
import Navigation from "../components/navigation.astro";
import Footer from "../components/footer.astro";
---

<BaseLayout>
    <main class="default-layout">
        <Navigation />
        <div class="content">
            <slot />
        </div>
        <Footer />
    </main>
</BaseLayout>

<style>
    .default-layout {
        display: flex;
        flex-direction: column;
    }
</style>
